# Local-only material: never commit
backups/
build/
.claude/settings.local.json
source/blender/private/

# Blender rolling backups / autosaves
*.blend1
*.blend2
*.blend@
quit.blend

# Python bytecode (contains absolute local paths)
__pycache__/
*.pyc

# Machine-specific tool configuration
tools/blender/blender-path.local.txt

# Editable .blend sources stay local for now: they can embed absolute local file paths.
# Regenerate them with tools/blender/*.py (scripts are committed).
source/blender/

# Diagnostic renders (PNG metadata includes local .blend paths)
previews/v0.4.0/diag/

